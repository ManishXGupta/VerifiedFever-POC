digraph architecture {
  rankdir=LR; nodesep=0.16; ranksep=0.26; fontname="Helvetica"; newrank=true;
  node [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#5b6472", fontname="Helvetica", fontsize=10, margin="0.07,0.04"];
  edge [color="#5b6472", fontname="Helvetica", fontsize=8.5, arrowsize=0.6];

  subgraph cluster_home { label="Home (parent consent)"; style="rounded,dashed"; color="#9aa3af"; fontsize=10;
    therm  [label="Registered\nthermometer\nEd25519 key\nsigns T, ts, seq", fillcolor="#e8f1fc"];
    app    [label="Parent app\nreading relay +\ncertificate wallet", fillcolor="#e8f1fc"];
  }
  subgraph cluster_cloud { label="Certification service"; style="rounded,dashed"; color="#9aa3af"; fontsize=10;
    verify [label="Evidence verifier\nenrollment, signature,\nsequence, freshness,\nplausibility", fillcolor="#fdeee7"];
    rules  [label="Rule engine\npersonal baseline\n+ school cutoff", fillcolor="#fdeee7"];
    cert   [label="Certificate\nservice\nissuer signature", fillcolor="#fdeee7"];
    surv   [label="Cohort surveillance\nclass / school\nCUSUM alerts", fillcolor="#fdeee7"];
  }
  nurse  [label="Nurse /\nphysician\none-click\nvalidation", fillcolor="#e6f6ef"];
  school [label="School portal\nverify signature,\naccept, excuse\n(dates + status only)", fillcolor="#e6f6ef"];
  ph     [label="Public health /\nschool nurse\nearly alert", fillcolor="#f3f4f6"];

  therm -> app [label="BLE"];
  app -> verify [label="HTTPS"];
  verify -> rules [label="accepted"];
  rules -> cert [label="febrile"];
  rules -> surv [label="daily flags", style=dashed];
  surv -> ph [label="alert", style=dashed];
  cert -> nurse;
  nurse -> app [label="approved\ncertificate", constraint=false, color="#0f7a45", fontcolor="#0f7a45"];
  app -> school [label="share: code / QR / file", color="#0f7a45", fontcolor="#0f7a45"];
}
