digraph flow {
  rankdir=TB; nodesep=0.22; ranksep=0.18; fontname="Helvetica";
  node [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#5b6472", fontname="Helvetica", fontsize=8.5, margin="0.07,0.03", height=0.3];
  edge [color="#5b6472", fontname="Helvetica", fontsize=7.5, arrowsize=0.55];

  start [label="Daily reading T signed on device", fillcolor="#e8f1fc"];
  v     [label="All evidence checks pass?", shape=diamond, fillcolor="#fdeee7", height=0.45];
  rej   [label="Reject and log reason\n(no certificate)", fillcolor="#f3f4f6"];
  b     [label="Baseline B = median of last 14\nafebrile readings (default 36.8 C)"];
  f     [label="T >= 38.0 C  or\n(T >= 37.5 C and T - B >= 1.0 C)?", shape=diamond, fillcolor="#fdeee7", height=0.55];
  w     [label="T - B >= 0.7 C: WATCH\nelse NORMAL (no certificate)", fillcolor="#f3f4f6"];
  e     [label="T >= 39.5 C or 3rd consecutive\nfever day?", shape=diamond, fillcolor="#fdeee7", height=0.5];
  c     [label="Issue / extend certificate\nabsence = fever day + 24 h", fillcolor="#e6f6ef"];
  x     [label="Certificate on hold:\nclinical review", fillcolor="#fde7e7"];
  n     [label="Nurse approves or rejects (one click)\nre-signed; school sees dates + status", fillcolor="#e6f6ef"];

  start -> v; v -> rej [label=" no"]; v -> b [label=" yes"]; b -> f;
  f -> w [label=" no"]; f -> e [label=" yes"];
  e -> c [label=" no"]; e -> x [label=" yes"];
  c -> n; x -> n;
  {rank=same; v; rej} {rank=same; f; w} {rank=same; c; x}
}
